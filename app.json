{
  "expo": {
    "name": "sett",
    "slug": "sett",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sett",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "be.maartencoppens.sett",
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "be.maartencoppens.sett",
      "permissions": ["READ_CALENDAR", "WRITE_CALENDAR"],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Sett uses your photos for your profile picture and group logos.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-localization",
      [
        "expo-calendar",
        {
          "calendarPermission": "Sett adds your groups' confirmed rehearsals and gigs to a separate calendar on your phone."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
